{
  "meta": {
    "name": "library-agent-eval",
    "version": "0.3",
    "note": "图书馆 Agent 功能评测集。基于内置种子数据（37 本书、6 读者、预置借阅场景）。判定依据：期望工具调用序列（exact=严格相等 / contains=子序列）+ 关键参数检查。",
    "seed": "internal/seed 内置书单；张三:三体(可续借)/活着(逾期)/围城(逾期,已续1次)+罚款2.4元；李四:百年孤独在借；王五:无在借；赵六:1984+Dune在借；三体全部副本借出(张三+钱七)保证预约可演示"
  },
  "cases": [
    {
      "id": "cat-01",
      "category": "检索",
      "patron": "张三",
      "input": "帮我查一下《三体》",
      "expected_tools": [
        "search_books"
      ],
      "tool_order": "contains",
      "check_args": [
        {
          "tool": "search_books",
          "param": "q",
          "contains": "三体"
        }
      ],
      "note": "单工具检索，书名提取（LLM 可能顺带查馆藏，属合理增强）"
    },
    {
      "id": "cat-02",
      "category": "检索",
      "patron": "张三",
      "input": "图书馆有乔治·奥威尔的书吗",
      "expected_tools": [
        "search_books"
      ],
      "tool_order": "contains",
      "check_args": [
        {
          "tool": "search_books",
          "param": "q",
          "contains": "奥威尔"
        }
      ],
      "note": "按作者检索"
    },
    {
      "id": "cat-03",
      "category": "检索",
      "patron": "张三",
      "input": "《三体》的馆藏情况怎么样",
      "expected_tools": [
        "search_books",
        "get_book_availability"
      ],
      "tool_order": "contains",
      "note": "检索后查馆藏，多工具编排"
    },
    {
      "id": "cat-04",
      "category": "检索",
      "patron": "张三",
      "input": "有哪些数学方面的书",
      "expected_tools": [
        "search_books"
      ],
      "tool_order": "contains",
      "check_args": [
        {
          "tool": "search_books",
          "param": "q",
          "contains": "数学"
        }
      ],
      "note": "按主题检索"
    },
    {
      "id": "circ-01",
      "category": "借阅",
      "patron": "张三",
      "input": "我要借《三体Ⅱ·黑暗森林》",
      "accept_tools": [
        "search_books",
        "get_book_availability",
        "guide_borrow"
      ],
      "expect_text": [
        "到馆"
      ],
      "note": "借书须到馆：可借时 LLM 可用工具或文字完成到馆引导（不线上借出），验证引导结果"
    },
    {
      "id": "circ-01b",
      "category": "借阅",
      "patron": "王五",
      "input": "帮我借《三体》",
      "expected_tools": [
        "search_books",
        "get_book_availability",
        "place_hold"
      ],
      "tool_order": "contains",
      "note": "三体全部借出：借书意图下自动转为预约排队"
    },
    {
      "id": "circ-02",
      "category": "借阅",
      "patron": "张三",
      "input": "帮我还书",
      "expected_tools": [
        "get_my_loans"
