      "tool_order": "contains",
      "note": "未指定哪本书：查询在借清单后询问具体书目（澄清优先于擅自归还）"
    },
    {
      "id": "circ-03",
      "category": "借阅",
      "patron": "张三",
      "input": "把《活着》还了",
      "expected_tools": [
